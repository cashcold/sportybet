# API-Sports Key (universal key across all subscribed sports: football, nba, nfl, etc.)
API_SPORTS_KEY=
API_FOOTBALL_KEY=
RAPIDAPI_KEY=

# Multi-Sport Quota & Rate-Limit Safety Controls
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_SAFETY_LIMIT=80

# Cache TTL Configuration (in seconds)
API_CACHE_FIXTURES_TTL=900
API_CACHE_LIVE_TTL=60
API_CACHE_RESULTS_TTL=2700
API_CACHE_STANDINGS_TTL=2700
API_CACHE_STATIC_TTL=86400

# Backend URL for client (optional in local dev)
VITE_API_URL=

# MongoDB URI (optional, in-memory store used when offline)
MONGODB_URI=

# Gemini API Key (optional)
GEMINI_API_KEY=
